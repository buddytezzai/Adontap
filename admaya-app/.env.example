# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL="postgresql://admaya:admaya@localhost:5433/admaya?schema=public"

# Signs the admin session cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# The seed script creates (or updates) this admin login. MVP-grade auth only.
ADMIN_EMAIL="admin@admaya.local"
ADMIN_PASSWORD="change-me"
