# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL="postgresql://admaya:admaya@localhost:5433/admaya?schema=public"

# Signs admin and customer session cookies. REQUIRED (min 16 chars) — there is no fallback.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# The seed script creates (or updates) this admin login. MVP-grade auth only.
ADMIN_EMAIL="admin@admaya.local"
ADMIN_PASSWORD="change-me"

# ── Security-relevant switches ─────────────────────────────────────────────────────────────
# Set to "true" ONLY when a trusted proxy (Vercel, nginx, Cloudflare) overwrites X-Forwarded-For.
# Otherwise rate limits share one global bucket (safe, but coarse).
# TRUST_PROXY="true"

# Free credits granted at signup. Default 0 — without email verification a bonus is free money.
# SIGNUP_BONUS_CREDITS="1200"

# Local development only: lets a signed-in customer add credits without paying. Ignored in production.
# ALLOW_DEV_TOPUP="true"

# Protects POST /api/cron/cleanup (24-hour retention). Min 16 chars. Endpoint returns 503 if unset.
# CRON_SECRET="change-me-to-a-long-random-string"

# ── Providers ─────────────────────────────────────────────────────────────────────────────
# Real renders (Seedance/Higgsfield engines) for signed-in, credit-paying customers only.
# HIGGSFIELD_API_KEY="KEY_ID:KEY_SECRET"
# HIGGSFIELD_MODEL="bytedance/seedance-2.5/text-to-video"
# META_ACCESS_TOKEN=""   # live Ad Library sync is not implemented yet; leave unset to use the stub

# Where customer uploads are stored (outside /public). Default: ./.uploads
# UPLOAD_DIR="./.uploads"
