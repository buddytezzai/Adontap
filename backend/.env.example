PORT=5000
# Allowed browser origins, comma-separated. Unset = same-origin only.
CORS_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Local fallback when no service account is configured. Prefer an admin custom claim or admins/{uid}.
ADMIN_EMAIL=
# Provide ONE of these. Never commit the key file itself.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/outside/the/repo/serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
