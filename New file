    payPanel.scrollIntoView({behavior:'smooth', block:'nearest'});
  });
  cancelPayBtn.addEventListener('click', ()=> payPanel.classList.remove('show'));
  confirmPayBtn.addEventListener('click', ()=>{
    const t = TEMPLATES.find(x=>x.id===activeTemplate);
