          <div class="pay-total"><span>Pay to generate</span><b id="payAmount">₹0</b></div>
          <div class="pay-actions">
            <button class="cta-btn" id="confirmPayBtn">Confirm &amp; pay</button>
            <button class="ghost-btn" id="cancelPayBtn">Cancel</button>
          </div>
        </div>
        <div class="progress-wrap" id="genProgress">
          <div class="progress-label"><span id="genProgressLabel">Charging your account…</span><span id="genProgressPct">0%</span></div>
          <div class="progress-track"><div class="progress-fill" id="genProgressFill"></div></div>
        </div>
        <div class="result-card" id="genResult">
          <div class="result-preview">
            <canvas class="result-watermark" id="resultWatermark"></canvas>
            <div class="phone-play"><div class="play-ring">▶</div></div>
          </div>
          <div class="result-body">
            <h4 id="resultTitle">Untitled render</h4>
            <div class="result-meta" id="resultMeta">00:00 · —</div>
            <div class="watermark-note"><span class="dot">●</span><span>Paid render — watermark stays on every preview and export so it can't be lifted by a screen recording. Clean masters are delivered separately to your ad account on request.</span></div>
            <div class="export-row">
              <button onclick="toast('Queued for Meta Ads Manager upload (watermarked)')">Send to Meta Ads</button>
              <button onclick="toast('Exported for Instagram Reels (watermarked)')">Export · Reels</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<section id="pricing">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow">Pricing</div>
        <h2>Credit packs — pay per video, not per month</h2>
      </div>
    </div>
    <div class="price-grid">
      <div class="price-card">
        <div class="price-tier">Starter</div>
        <div class="price-amount">₹499</div>
        <div class="price-note">First-time / trial users</div>
        <ul class="price-list">
          <li>≈3 template videos</li>
          <li>Credits never expire</li>
          <li>All 8 templates</li>
        </ul>
        <button class="ghost-btn" onclick="toast('This is a prototype — no live checkout yet')">Buy credits</button>
      </div>
      <div class="price-card featured">
        <div class="price-tier">Creator</div>
        <div class="price-amount">₹1,999</div>
        <div class="price-note">Regular solo creators &amp; small brands</div>
        <ul class="price-list">
          <li>≈13 template videos (bonus included)</li>
          <li>Priority render queue</li>
          <li>Send-to-Meta export</li>
        </ul>
        <button class="cta-btn" onclick="toast('This is a prototype — no live checkout yet')">Buy credits</button>
