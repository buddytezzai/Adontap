<title>AdMaya.ai</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --void:      #14121f;
    --surface:   #1c1930;
    --surface-2: #24213c;
    --stroke:    #34304f;
    --stroke-soft: #2a273f;
    --ink:       #f2ede1;
    --ink-dim:   #b8b2c9;
    --ink-faint: #7c7793;
    --marigold:  #eaa23a;
    --marigold-ink: #2a1a05;
    --peacock:   #21a693;
    --sindoor:   #e15b64;
    --violet:    #8b7ff0;
    --font-display: "Fraunces", "Iowan Old Style", ui-serif, Georgia, serif;
    --font-body: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, "SF Mono", monospace;
  }
  /* Single committed dark world — matches how video-review tools stay dark so
     footage previews read true. Every color below is declared explicitly. */
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{ background:var(--void); color:var(--ink); font-family:var(--font-body); font-size:16px; line-height:1.6; -webkit-font-smoothing:antialiased; }
  ::selection{ background:var(--marigold); color:var(--marigold-ink); }
  h1,h2,h3{ font-family:var(--font-display); text-wrap:balance; margin:0; color:var(--ink); }
  p{ margin:0; }
  a{ color:inherit; }
  button{ font-family:var(--font-body); }
  .eyebrow{ font-family:var(--font-mono); font-size:.72rem; letter-spacing:.14em; text-transform:uppercase; color:var(--marigold); }
  .wrap{ max-width:1180px; margin:0 auto; padding:0 32px; }
  @media (max-width:720px){ .wrap{ padding:0 20px; } }
  /* topbar */
  .topbar{ position:sticky; top:0; z-index:40; background:rgba(20,18,31,.88); backdrop-filter:blur(10px); border-bottom:1px solid var(--stroke-soft); }
  .topbar-inner{ display:flex; align-items:center; justify-content:space-between; padding:16px 0; }
  .brand{ display:flex; align-items:center; gap:10px; }
  .brand-mark{ width:32px; height:32px; border-radius:9px; background:linear-gradient(155deg, var(--marigold), var(--sindoor)); display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:700; color:var(--marigold-ink); font-size:16px; flex:none; }
  .brand-name{ font-family:var(--font-display); font-weight:600; font-size:1.15rem; letter-spacing:.01em; }
  .brand-name em{ font-style:normal; color:var(--marigold); }
  .topnav{ display:flex; gap:28px; }
  .topnav a{ font-size:.9rem; color:var(--ink-dim); text-decoration:none; transition:color .15s; }
  .topnav a:hover{ color:var(--ink); }
  .cta-btn{ background:var(--marigold); color:var(--marigold-ink); border:none; padding:10px 18px; border-radius:8px; font-weight:600; font-size:.88rem; cursor:pointer; transition:transform .12s, box-shadow .12s; }
  .cta-btn:hover{ transform:translateY(-1px); box-shadow:0 8px 20px -8px rgba(234,162,58,.6); }
  .cta-btn:disabled{ opacity:.55; cursor:progress; transform:none; box-shadow:none; }
  .cta-btn:focus-visible, a:focus-visible, button:focus-visible, select:focus-visible, textarea:focus-visible, input:focus-visible{ outline:2px solid var(--peacock); outline-offset:2px; }
  .ghost-btn{ background:transparent; color:var(--ink); border:1px solid var(--stroke); padding:9px 16px; border-radius:8px; font-size:.86rem; font-weight:500; cursor:pointer; }
  .ghost-btn:hover{ border-color:var(--ink-faint); }
  @media (max-width:820px){ .topnav{ display:none; } }
  /* hero */
  .hero{ position:relative; padding:88px 0 64px; overflow:hidden; }
  .hero-grid{ display:grid; grid-template-columns:1.05fr .95fr; gap:56px; align-items:center; }
  @media (max-width:900px){ .hero-grid{ grid-template-columns:1fr; } }
  .hero h1{ font-size:clamp(2.3rem, 4.2vw, 3.4rem); font-weight:600; line-height:1.08; margin:14px 0 20px; }
  .hero h1 .accent{ color:var(--marigold); font-style:italic; font-weight:500; }
  .hero-sub{ font-size:1.06rem; color:var(--ink-dim); max-width:52ch; margin-bottom:30px; }
  .hero-actions{ display:flex; gap:14px; flex-wrap:wrap; margin-bottom:34px; }
  .hero-stats{ display:flex; gap:32px; flex-wrap:wrap; }
  .hero-stat b{ display:block; font-family:var(--font-mono); font-size:1.25rem; color:var(--ink); font-variant-numeric:tabular-nums; }
  .hero-stat span{ font-size:.76rem; color:var(--ink-faint); }
  /* phone mockup */
  .phone-wrap{ display:flex; justify-content:center; }
  .phone{ width:220px; aspect-ratio:9/16; border-radius:22px; border:1px solid var(--stroke); background:linear-gradient(160deg,#2c2148,#150f22 65%); position:relative; overflow:hidden; box-shadow:0 40px 70px -30px rgba(0,0,0,.7); }
  .phone-badge{ position:absolute; top:12px; left:12px; display:flex; align-items:center; gap:6px; background:rgba(20,18,31,.55); backdrop-filter:blur(4px); padding:5px 9px; border-radius:999px; font-family:var(--font-mono); font-size:.62rem; color:var(--ink-dim); z-index:3; }
  .live-dot{ width:6px; height:6px; border-radius:50%; background:var(--sindoor); display:inline-block; animation:pulse 1.8s ease-in-out infinite; }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:.35;} }
  .phone-watermark{ position:absolute; inset:0; z-index:2; opacity:.55; pointer-events:none; }
  .phone-play{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center; z-index:3; }
  .play-ring{ width:46px; height:46px; border-radius:50%; border:1.5px solid rgba(242,237,225,.8); display:flex; align-items:center; justify-content:center; color:var(--ink); font-size:.85rem; background:rgba(20,18,31,.35); }
  .phone-caption{ position:absolute; left:0; right:0; bottom:0; z-index:3; padding:10px 12px; background:linear-gradient(0deg, rgba(20,18,31,.9), transparent); font-family:var(--font-mono); font-size:.62rem; color:var(--ink-dim); }
  .phone-caption b{ color:var(--ink); font-weight:600; }
  .hero-note{ text-align:center; margin-top:14px; font-size:.78rem; color:var(--ink-faint); max-width:230px; }
  /* sections */
  section{ padding:64px 0; border-top:1px solid var(--stroke-soft); }
  .section-head{ display:flex; justify-content:space-between; align-items:flex-end; gap:24px; margin-bottom:32px; flex-wrap:wrap; }
  .section-head h2{ font-size:1.85rem; font-weight:600; }
  .section-desc{ color:var(--ink-dim); max-width:58ch; margin-top:8px; }
  /* template gallery */
  .tmpl-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:18px; }
  .tmpl-card{ border:1px solid var(--stroke); background:var(--surface); border-radius:14px; overflow:hidden; cursor:pointer; transition:.15s; text-align:left; display:flex; flex-direction:column; }
  .tmpl-card:hover{ border-color:var(--ink-faint); transform:translateY(-2px); }
  .tmpl-card.selected{ border-color:var(--marigold); box-shadow:0 0 0 1px var(--marigold); }
  .tmpl-thumb{ position:relative; aspect-ratio:9/11; display:flex; align-items:center; justify-content:center; }
  .tmpl-thumb .play-ring{ width:38px; height:38px; font-size:.75rem; }
  .tmpl-icon{ font-size:1.6rem; opacity:.9; }
  .tmpl-dur{ position:absolute; bottom:9px; right:9px; background:rgba(20,18,31,.6); backdrop-filter:blur(3px); font-family:var(--font-mono); font-size:.68rem; color:var(--ink); padding:3px 7px; border-radius:5px; }
  .tmpl-body{ padding:13px 14px 15px; }
  .tmpl-cat{ font-family:var(--font-mono); font-size:.66rem; text-transform:uppercase; letter-spacing:.08em; color:var(--peacock); }
  .tmpl-title{ font-family:var(--font-display); font-weight:600; font-size:1rem; margin:5px 0 8px; }
  .tmpl-foot{ display:flex; justify-content:space-between; align-items:center; }
  .tmpl-price{ font-family:var(--font-mono); font-size:.82rem; color:var(--ink); font-weight:600; }
  .tmpl-use{ font-size:.76rem; color:var(--marigold); font-weight:600; }
  /* studio */
  .studio-shell{ display:grid; grid-template-columns:.85fr 1.15fr; gap:0; border:1px solid var(--stroke); border-radius:16px; overflow:hidden; background:var(--surface); }
  @media (max-width:860px){ .studio-shell{ grid-template-columns:1fr; } }
  .studio-locked{ background:var(--void); border-right:1px solid var(--stroke); padding:26px; }
  @media (max-width:860px){ .studio-locked{ border-right:none; border-bottom:1px solid var(--stroke); } }
  .locked-label{ font-family:var(--font-mono); font-size:.7rem; text-transform:uppercase; letter-spacing:.09em; color:var(--ink-faint); margin-bottom:6px; }
  .locked-title{ font-family:var(--font-display); font-size:1.2rem; font-weight:600; margin-bottom:4px; }
  .locked-cat{ font-size:.82rem; color:var(--peacock); margin-bottom:18px; }
  .lock-row{ display:flex; gap:10px; padding:10px 0; border-top:1px solid var(--stroke-soft); font-size:.84rem; }
  .lock-row:first-of-type{ border-top:none; }
  .lock-row .k{ color:var(--ink-faint); min-width:88px; flex:none; font-family:var(--font-mono); font-size:.72rem; text-transform:uppercase; letter-spacing:.06em; padding-top:2px; }
  .lock-row .v{ color:var(--ink-dim); }
  .lock-chip{ display:inline-block; margin-top:16px; font-family:var(--font-mono); font-size:.7rem; color:var(--ink-faint); border:1px dashed var(--stroke); padding:6px 10px; border-radius:7px; }
  .studio-main{ padding:26px 28px 30px; }
  .field{ display:flex; flex-direction:column; gap:6px; margin-bottom:18px; }
  .field label{ font-size:.76rem; text-transform:uppercase; letter-spacing:.08em; color:var(--ink-faint); font-family:var(--font-mono); }
  textarea{ background:var(--void); border:1px solid var(--stroke); color:var(--ink); border-radius:8px; padding:12px 13px; font-family:var(--font-body); font-size:.94rem; resize:vertical; min-height:130px; line-height:1.55; }
  .gen-btn{ background:var(--marigold); color:var(--marigold-ink); border:none; padding:12px 22px; border-radius:9px; font-weight:700; font-size:.92rem; cursor:pointer; display:inline-flex; align-items:center; gap:8px; }
  .gen-btn:hover{ filter:brightness(1.06); }
  .gen-btn:disabled{ opacity:.55; cursor:progress; }
  /* pay panel */
  .pay-panel{ display:none; margin-top:20px; border:1px solid var(--marigold); background:rgba(234,162,58,.06); border-radius:12px; padding:18px 20px; }
  .pay-panel.show{ display:block; animation:fade .2s ease; }
  @keyframes fade{ from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:none;} }
  .pay-row{ display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; font-size:.88rem; color:var(--ink-dim); }
  .pay-row b{ color:var(--ink); font-family:var(--font-mono); }
  .pay-total{ display:flex; justify-content:space-between; align-items:center; padding-top:10px; margin-top:8px; border-top:1px solid var(--stroke-soft); font-size:.95rem; font-weight:600; }
  .pay-total b{ font-family:var(--font-mono); color:var(--marigold); font-size:1.1rem; }
  .pay-actions{ display:flex; gap:10px; margin-top:14px; }
  .progress-wrap{ margin-top:20px; display:none; }
  .progress-wrap.show{ display:block; }
  .progress-label{ display:flex; justify-content:space-between; font-family:var(--font-mono); font-size:.78rem; color:var(--ink-dim); margin-bottom:8px; }
  .progress-track{ height:6px; border-radius:4px; background:var(--surface-2); overflow:hidden; }
  .progress-fill{ height:100%; width:0%; background:linear-gradient(90deg,var(--marigold),var(--sindoor)); transition:width .25s linear; }
  .result-card{ margin-top:24px; border:1px solid var(--stroke); border-radius:14px; overflow:hidden; display:none; background:var(--void); }
  .result-card.show{ display:grid; grid-template-columns:170px 1fr; }
  @media (max-width:640px){ .result-card.show{ grid-template-columns:1fr; } }
  .result-preview{ position:relative; aspect-ratio:9/16; background:linear-gradient(165deg,#241c3a,#150f22); border-right:1px solid var(--stroke); overflow:hidden; }
  @media (max-width:640px){ .result-preview{ border-right:none; border-bottom:1px solid var(--stroke); aspect-ratio:16/9; } }
  .result-watermark{ position:absolute; inset:0; opacity:.55; }
  .result-preview .phone-play{ z-index:4; }
  .result-body{ padding:18px 20px; }
  .result-body h4{ font-family:var(--font-display); font-size:1.05rem; font-weight:600; margin-bottom:4px; }
  .result-meta{ font-family:var(--font-mono); font-size:.78rem; color:var(--ink-faint); margin-bottom:6px; }
  .watermark-note{ display:flex; gap:7px; align-items:flex-start; font-size:.78rem; color:var(--ink-dim); background:var(--surface-2); border-radius:8px; padding:9px 11px; margin-bottom:14px; }
  .watermark-note .dot{ color:var(--sindoor); flex:none; }
  .export-row{ display:flex; gap:8px; flex-wrap:wrap; }
  .export-row button{ background:var(--surface-2); border:1px solid var(--stroke); color:var(--ink); padding:8px 13px; border-radius:7px; font-size:.8rem; cursor:pointer; }
  .export-row button:hover{ border-color:var(--peacock); color:var(--peacock); }
  /* pricing */
  .price-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; }
  .price-card{ border:1px solid var(--stroke); background:var(--surface); border-radius:14px; padding:22px; display:flex; flex-direction:column; }
  .price-card.featured{ border-color:var(--marigold); box-shadow:0 0 0 1px var(--marigold) inset; }
  .price-tier{ font-family:var(--font-mono); font-size:.76rem; text-transform:uppercase; letter-spacing:.1em; color:var(--ink-faint); margin-bottom:10px; }
  .price-amount{ font-family:var(--font-display); font-size:2rem; font-weight:600; margin-bottom:4px; }
  .price-amount span{ font-size:.95rem; color:var(--ink-faint); font-family:var(--font-body); }
  .price-note{ font-size:.82rem; color:var(--ink-dim); margin-bottom:18px; }
  .price-list{ list-style:none; margin:0 0 20px; padding:0; display:flex; flex-direction:column; gap:9px; font-size:.86rem; color:var(--ink-dim); }
  .price-list li::before{ content:"—"; color:var(--marigold); margin-right:8px; }
  .price-card .ghost-btn, .price-card .cta-btn{ margin-top:auto; text-align:center; }
  footer{ padding:40px 0 60px; }
  .foot-row{ display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; color:var(--ink-faint); font-size:.82rem; }
  .toast{ position:fixed; bottom:26px; left:50%; transform:translateX(-50%) translateY(20px); background:var(--surface-2); border:1px solid var(--stroke); color:var(--ink); padding:12px 18px; border-radius:10px; font-size:.86rem; opacity:0; pointer-events:none; transition:opacity .2s, transform .2s; z-index:60; box-shadow:0 20px 40px -20px rgba(0,0,0,.6); max-width:88vw; text-align:center; }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }
  @media (prefers-reduced-motion:reduce){ *{ animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; } }
</style>
<div class="topbar">
  <div class="wrap topbar-inner">
    <div class="brand">
      <div class="brand-mark">A</div>
      <div class="brand-name">AdMaya<em>.ai</em></div>
    </div>
    <nav class="topnav">
      <a href="#templates">Templates</a>
      <a href="#studio">Studio</a>
      <a href="#pricing">Pricing</a>
    </nav>
    <button class="cta-btn" onclick="document.getElementById('templates').scrollIntoView({behavior:'smooth'})">Browse templates</button>
  </div>
</div>
<div class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow">AI video ads for Meta &amp; product promotion</div>
      <h1>Pick a template. Drop in your script. <span class="accent">Ship the ad.</span></h1>
      <p class="hero-sub">AdMaya.ai is a template-based AI video ad generator for brands — no subscription to Higgsfield, Seedance, or any other AI engine required. Everything except your script is locked into the template; you pay per video, only when you generate.</p>
      <div class="hero-actions">
        <button class="cta-btn" onclick="document.getElementById('templates').scrollIntoView({behavior:'smooth'})">Browse templates</button>
        <button class="ghost-btn" onclick="document.getElementById('pricing').scrollIntoView({behavior:'smooth'})">See pricing</button>
      </div>
      <div class="hero-stats">
        <div class="hero-stat"><b>8</b><span>ad templates live</span></div>
        <div class="hero-stat"><b>₹0</b><span>subscription required</span></div>
        <div class="hero-stat"><b>₹129+</b><span>per generated video</span></div>
      </div>
    </div>
    <div>
      <div class="phone-wrap">
        <div class="phone">
          <div class="phone-badge"><span class="live-dot"></span>PREVIEW</div>
          <canvas class="phone-watermark" id="heroWatermark"></canvas>
          <div class="phone-play"><div class="play-ring">▶</div></div>
          <div class="phone-caption">Product Unboxing UGC · 15s · <b>AdMaya.ai</b></div>
        </div>
      </div>
      <p class="hero-note">Every preview and export carries a visible AdMaya.ai watermark — it can't be screenshotted or downloaded clean without going through checkout.</p>
    </div>
  </div>
</div>
<section id="templates">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow">Step 1 — pick a template</div>
        <h2>UGC &amp; product ad templates</h2>
        <p class="section-desc">The look, environment, camera movement and pacing are locked into each template. You only ever change the script.</p>
      </div>
    </div>
    <div class="tmpl-grid" id="tmplGrid"></div>
  </div>
</section>
<section id="studio">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow">Step 2 — the studio</div>
        <h2>Write your script, generate, pay once</h2>
        <p class="section-desc">Everything about how the ad looks was decided when the template was built. You write the words — AdMaya renders the video.</p>
      </div>
    </div>
    <div class="studio-shell">
      <div class="studio-locked">
        <div class="locked-label">Selected template</div>
        <div class="locked-title" id="lockTitle">Unbox &amp; React</div>
        <div class="locked-cat" id="lockCat">E-commerce · UGC Unboxing</div>
        <div class="lock-row"><div class="k">Environment</div><div class="v" id="lockEnv">Home desk setup, natural window light</div></div>
        <div class="lock-row"><div class="k">Camera</div><div class="v" id="lockCam">Handheld phone-style, static crop</div></div>
        <div class="lock-row"><div class="k">Pacing</div><div class="v" id="lockPace">Quick cuts, on-screen captions</div></div>
        <div class="lock-row"><div class="k">Engine</div><div class="v" id="lockEngine">Seedance · 15s render</div></div>
        <div class="lock-chip">🔒 locked — only the script is editable</div>
      </div>
      <div class="studio-main">
        <div class="field">
          <label>Your script</label>
          <textarea id="scriptBox"></textarea>
